    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_income"
        android:shortcutShortLabel="@string/shortcut_add_income"
        android:shortcutLongLabel="@string/shortcut_add_income_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.makemission.makeflow"
            android:targetClass="com.makemission.makeflow.MainActivity">
            <extra android:name="shortcut_type" android:value="INCOME" />
        </intent>
    </shortcut>
