        android:enabled="true"
        android:icon="@drawable/ic_shortcut_expense"
        android:shortcutShortLabel="@string/shortcut_add_expense"
        android:shortcutLongLabel="@string/shortcut_add_expense_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.makemission.makeflow"
            android:targetClass="com.makemission.makeflow.MainActivity">
            <extra android:name="shortcut_type" android:value="EXPENSE" />
